# Copy to .env and fill in. Never commit .env.
CLAIMLENS_PROVIDER=gemini
CLAIMLENS_MODEL_PLANNER=gemma-4-31b-it
CLAIMLENS_MODEL_AGENT=gemma-4-26b-a4b-it
CLAIMLENS_MODEL_FAST=gemma-4-e4b-it
CLAIMLENS_MAX_CONTEXT=30000
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Automatic failover when the primary provider returns HTTP 429.
# Default: gemini -> openrouter (needs OPENROUTER_API_KEY). Empty disables.
CLAIMLENS_FALLBACK_PROVIDER=openrouter
# Models used whenever the effective provider is OpenRouter. Only these
# two free Gemma 4 variants are allowed.
CLAIMLENS_OPENROUTER_MODEL_PLANNER=google/gemma-4-31b-it:free
CLAIMLENS_OPENROUTER_MODEL_AGENT=google/gemma-4-26b-a4b-it:free
CLAIMLENS_OPENROUTER_MODEL_FAST=google/gemma-4-26b-a4b-it:free
# Local fallback (manual switch): run ./scripts/setup_ollama.sh on the
# machine that serves Ollama, then set CLAIMLENS_PROVIDER=ollama.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
# CLAIMLENS_MODEL_PLANNER=gemma3:4b
# CLAIMLENS_MODEL_AGENT=gemma3:4b
# CLAIMLENS_MODEL_FAST=gemma3:4b
# Web API and mock mode.
CLAIMLENS_MOCK_PIPELINE=0
CLAIMLENS_MOCK_DELAY=
CLAIMLENS_MAX_CONCURRENT_RUNS=1
CLAIMLENS_RUNS_ROOT=runs
CLAIMLENS_PROD=0
